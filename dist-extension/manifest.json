{
  "manifest_version": 3,
  "name": "Visual Bookmark Dashboard",
  "description": "Replaces the new tab page with a visual, drag-and-drop bookmark dashboard.",
  "version": "1.0.0",
  "minimum_chrome_version": "114",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["bookmarks", "storage", "favicon", "unlimitedStorage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
