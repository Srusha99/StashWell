{
  "manifest_version": 3,
  "name": "Bookmark Manager",
  "description": "A visual bookmark manager that replaces the New Tab page.",
  "version": "1.0.0",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["bookmarks"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
